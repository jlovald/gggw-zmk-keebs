#include "crosses.dtsi"

/ {
	chosen {
		zmk,kscan = &mock_kscan;
		zephyr,display = &oled;
	};

	mock_kscan: kscan_1 {
		compatible = "zmk,kscan-mock";
		columns = <0>;
		rows = <0>;
		events = <0>;
	};
};

&kscan0 {
	status = "disabled";
};

&trackball_left_listener {
  status = "okay";
};


&trackball_right_listener {
  status = "okay";
};


&pinctrl {
    i2c0_default: i2c0_default {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 0, 17)>,
                <NRF_PSEL(TWIM_SCL, 0, 20)>;
        };
    };

    i2c0_sleep: i2c0_sleep {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 0,17)>,
                <NRF_PSEL(TWIM_SCL, 0, 20)>;
            low-power-enable;
        };
    };	
}; 

&i2c0 {
    status = "okay"; /* make sure the bus is enabled */

    oled: sh1106@3c {
    compatible = "sinowealth,sh1106";
    reg = <0x3c>;
    width = <128>;
    height = <64>;
    multiplex-ratio = <63>;
    segment-offset = <0>;
    page-offset = <0>;
    display-offset = <0>;
    prechargep = <0x22>;
};
};

