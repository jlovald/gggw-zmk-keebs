#include "crosses.dtsi"

&kscan0 {
  col-gpios
    = <&gpio0 8 (GPIO_ACTIVE_LOW | GPIO_PULL_DOWN)>;
	row-gpios
        = <&gpio0 24 GPIO_ACTIVE_LOW>
         ;
};

&default_transform {~~~~~~~~~~~~~
  col-offset = <0>;
  row-offset = <0>;
};


