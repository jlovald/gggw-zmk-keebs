if SHIELD_CROSSES_DONGLE

config ZMK_KEYBOARD_NAME
    default "Crosses BT"

config ZMK_SPLIT_ROLE_CENTRAL
    default y

endif # SHIELD_CROSSES_DONGLE


if SHIELD_CROSSES_LEFT || SHIELD_CROSSES_RIGHT

config ZMK_SPLIT
    default y

if ZMK_DISPLAY

config I2C
    default y

config SSD1306
    default y

endif # ZMK_DISPLAY

endif # SHIELD_CROSSES_LEFT || SHIELD_CROSSES_RIGHT

if SHIELD_CROSSES_PEDALS
config ZMK_SPLIT
    default y
endif # PEDALS

if SHIELD_CROSSES_DONGLE

if ZMK_DISPLAY

config I2C
    default y

config SSD1306
    default y

choice ZMK_DISPLAY_WORK_QUEUE
    default ZMK_DISPLAY_WORK_QUEUE_DEDICATED
endchoice

if SSD1306

config LV_Z_VDB_SIZE
    default 64

config LV_DPI_DEF
    default 148

config LV_Z_BITS_PER_PIXEL
    default 1

choice LV_COLOR_DEPTH
    default LV_COLOR_DEPTH_1
endchoice

endif # SSD1306
endif # ZMK_DISPLAY
endif # SHIELD_CROSSES_DONGLE
